        "sendTo": "codinplus31@gmail.com",
        "subject": "=⚠️ n8n Error: {{ $('Error Trigger').item.json.workflow.name }}",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 620px; padding: 28px; border: 1px solid #e5e5e5; border-radius: 10px;\">\n\n  <h2 style=\"margin: 0 0 6px; color: #A32D2D; font-size: 20px;\">⚠️ Workflow Failed</h2>\n  <p style=\"margin: 0 0 24px; font-size: 13px; color: #999;\">This error has been saved to your <b>error_log</b> table.</p>\n\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 14px;\">\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888; width: 150px;\">Workflow</td>\n      <td style=\"padding: 10px 0; font-weight: bold;\">{{ $('Error Trigger').item.json.workflow.name }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Workflow ID</td>\n      <td style=\"padding: 10px 0; font-family: monospace; font-size: 12px;\">{{ $('Error Trigger').item.json.workflow.id }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Failed Node</td>\n      <td style=\"padding: 10px 0;\">{{ $('Error Trigger').item.json.execution.lastNodeExecuted }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Error Message</td>\n      <td style=\"padding: 10px 0; color: #A32D2D; font-weight: 500;\">{{ $('Error Trigger').item.json.execution.error.message }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Execution ID</td>\n      <td style=\"padding: 10px 0; font-family: monospace; font-size: 12px;\">{{ $('Error Trigger').item.json.execution.id }}</td>\n    </tr>\n    <tr style=\"border-bottom: 1px solid #f0f0f0;\">\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Mode</td>\n      <td style=\"padding: 10px 0;\">{{ $('Error Trigger').item.json.execution.mode }}</td>\n    </tr>\n    <tr>\n      <td style=\"padding: 10px 16px 10px 0; color: #888;\">Time</td>\n      <td style=\"padding: 10px 0;\">{{ $now.toFormat('yyyy-MM-dd HH:mm:ss') }} UTC</td>\n    </tr>\n  </table>\n\n  <div style=\"margin-top: 24px; padding: 14px; background: #fff8f8; border-left: 3px solid #A32D2D; border-radius: 4px;\">\n    <p style=\"margin: 0 0 8px; font-size: 13px; font-weight: bold; color: #A32D2D;\">Stack Trace</p>\n    <pre style=\"margin: 0; font-size: 11px; color: #555; white-space: pre-wrap; word-break: break-word;\">{{ $('Error Trigger').item.json.execution.error.stack }}</pre>\n  </div>\n\n  <div style=\"margin-top: 20px; padding: 12px 14px; background: #f0f7ff; border-left: 3px solid #185FA5; border-radius: 4px; font-size: 13px; color: #185FA5;\">\n    ✅ Saved to <b>error_log</b> table (content + metadata + embedding).\n  </div>\n\n  <p style=\"margin: 20px 0 0; font-size: 12px; color: #bbb;\">Sent automatically by your n8n _Error Handler workflow.</p>\n\n</div>",
