{
  "name": "_Error Handler (Supabase + Email)",
  "nodes": [
    {
      "parameters": {},
      "id": "15cd930e-67d4-4f2f-af4b-8f5433f4a59a",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -720,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\nconst execution = error.execution || {};\nconst workflow = error.workflow || {};\n\n// content: searchable text for embedding\nconst content = `Workflow: ${workflow.name || 'Unknown'}\\nError: ${execution.error?.message || 'Unknown error'}\\nNode: ${execution.lastNodeExecuted || 'Unknown'}`;\n\n// metadata: structured JSONB data\nconst metadata = {\n  workflow_id: workflow.id,\n  workflow_name: workflow.name,\n  error_message: execution.error?.message || '',\n  error_stack: execution.error?.stack || '',\n  execution_id: execution.id,\n  failed_node: execution.lastNodeExecuted,\n  execution_mode: execution.mode,\n  retry_of: execution.retryOf || null\n};\n\nreturn [{\n  json: {\n    content: content,\n    metadata: metadata\n  }\n}];"
      },
      "id": "ac847558-b2a5-4b53-aa23-becc61c58163",
      "name": "Format for error_log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -464,
        112
      ]
    },
    {
      "parameters": {
        "tableId": "error_logs",
        "fieldsUi": {
          "fieldValues": [
